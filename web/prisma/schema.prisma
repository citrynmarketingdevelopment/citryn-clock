generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum ClockEventType {
  CLOCK_IN
  BREAK_START
  BREAK_END
  CLOCK_OUT
}

enum ProjectMemberRole {
  MEMBER
  MANAGER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskRecurrenceFrequency {
  NONE
  WEEKLY
  MONTHLY
}

enum TaskAttachmentType {
  IMAGE
  LINK
}

enum ProjectFieldType {
  TEXT
  NUMBER
  SELECT
  DATE
  CHECKBOX
  SUBTASKS
}

model User {
  id                   String                 @id @default(cuid())
  email                String                 @unique
  name                 String
  passwordHash         String
  role                 Role                   @default(EMPLOYEE)
  events               ClockEvent[]
  ownedProjects        Project[]              @relation("ProjectOwner")
  projectMemberships   ProjectMember[]
  createdTasks         Task[]                 @relation("TaskCreator")
  taskAttachments      TaskAttachment[]
  taskAssignments      TaskAssignment[]       @relation("TaskAssignee")
  taskAssignmentsGiven TaskAssignment[]       @relation("TaskAssignedBy")
  kitchenVideos        KitchenVideo[]
  dayOverrides         TimesheetDayOverride[] @relation("TimesheetOverrideUser")
  dayOverridesSet      TimesheetDayOverride[] @relation("TimesheetOverrideAdmin")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model ClockEvent {
  id         String         @id @default(cuid())
  userId     String
  type       ClockEventType
  occurredAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  ownerId     String
  order       Int             @default(0)
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  columns     ProjectColumn[]
  tasks       Task[]
  fields      ProjectField[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([ownerId, createdAt])
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(MEMBER)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())

  @@unique([projectId, userId])
  @@index([userId, createdAt])
}

model ProjectColumn {
  id        String   @id @default(cuid())
  projectId String
  name      String
  order     Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, order])
  @@index([projectId, createdAt])
}

model Task {
  id                        String                  @id @default(cuid())
  projectId                 String
  columnId                  String?
  title                     String
  description               String
  laborMinutes              Int
  priority                  TaskPriority            @default(MEDIUM)
  dueDate                   DateTime?
  completedAt               DateTime?
  recurrenceFrequency       TaskRecurrenceFrequency @default(NONE)
  recurrenceInterval        Int                     @default(1)
  recurrenceDayOfWeek       Int?
  recurrenceDayOfMonth      Int?
  recurrenceLastCompletedAt DateTime?
  createdById               String
  project                   Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column                    ProjectColumn?          @relation(fields: [columnId], references: [id], onDelete: SetNull)
  createdBy                 User                    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments               TaskAssignment[]
  attachments               TaskAttachment[]
  fieldValues               TaskFieldValue[]
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@index([projectId, createdAt])
  @@index([dueDate])
  @@index([completedAt])
  @@index([recurrenceFrequency])
}

model ProjectField {
  id        String           @id @default(cuid())
  projectId String
  name      String
  type      ProjectFieldType @default(TEXT)
  order     Int
  options   Json?
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values    TaskFieldValue[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([projectId, order])
}

model TaskFieldValue {
  id        String       @id @default(cuid())
  taskId    String
  fieldId   String
  value     Json?
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  field     ProjectField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([taskId, fieldId])
  @@index([fieldId])
}

model TaskAttachment {
  id          String             @id @default(cuid())
  taskId      String
  createdById String
  type        TaskAttachmentType
  url         String
  label       String?
  blobPath    String?
  task        Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([taskId, createdAt])
  @@index([createdById, createdAt])
}

model TaskAssignment {
  id           String   @id @default(cuid())
  taskId       String
  userId       String
  assignedById String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User     @relation("TaskAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User     @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  assignedAt   DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId, assignedAt])
}

model KitchenVideo {
  id               String                @id @default(cuid())
  uploaderId       String
  recipientEmail   String
  title            String?
  originalFileName String
  fileUrl          String
  shareToken       String                @unique
  uploader         User                  @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  comments         KitchenVideoComment[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([uploaderId, createdAt])
  @@index([shareToken])
}

model KitchenVideoComment {
  id               String       @id @default(cuid())
  kitchenVideoId   String
  authorEmail      String
  body             String
  timestampSeconds Int
  kitchenVideo     KitchenVideo @relation(fields: [kitchenVideoId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())

  @@index([kitchenVideoId, createdAt])
}

model TimesheetDayOverride {
  id               String   @id @default(cuid())
  userId           String
  day              DateTime @db.Date
  workedSeconds    Int
  updatedByAdminId String
  user             User     @relation("TimesheetOverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  updatedByAdmin   User     @relation("TimesheetOverrideAdmin", fields: [updatedByAdminId], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, day])
  @@index([day, userId])
}
